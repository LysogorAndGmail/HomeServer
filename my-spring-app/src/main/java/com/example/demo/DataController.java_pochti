@PostMapping("/stream")
public ResponseEntity<String> streamAudio(InputStream inputStream) {
    try {
        // Убедись, что буфер не слишком огромный
        byte[] buffer = new byte[4096]; 
        int bytesRead;
        
        while ((bytesRead = inputStream.read(buffer)) != -1) {
            // Важно: передаем только реально прочитанные байты!
            if (recognizer.acceptWaveForm(buffer, bytesRead)) {
                // Здесь можно ловить промежуточные результаты
            }
        }

        // КЛЮЧЕВОЙ МОМЕНТ:
        // Vosk должен понять, что поток окончен, чтобы выдать финальный текст
        String result = recognizer.getFinalResult();
        
        // Логируем в консоль для отладки
        System.out.println("VOSK РЕЗУЛЬТАТ: " + result);

        // Сохраняем в БД
        ApiLog log = new ApiLog();
        log.setProjects("MSI-Final-Test");
        log.setLogUrl(result); // Кладем текст распознавания сюда
        log.setCreatedAt(LocalDateTime.now());
        repository.save(log);

        return ResponseEntity.ok(result);
    } catch (Exception e) {
        return ResponseEntity.status(500).body("Ошибка: " + e.getMessage());
    }
}
}

